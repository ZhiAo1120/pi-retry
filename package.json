{
  "name": "pi-retry",
  "version": "0.1.0",
  "description": "Best-effort manual /retry command for the Pi coding agent",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "retry"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "ZhiAo1120",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiAo1120/pi-retry.git"
  },
  "homepage": "https://github.com/ZhiAo1120/pi-retry#readme",
  "bugs": {
    "url": "https://github.com/ZhiAo1120/pi-retry/issues"
  },
  "files": [
    "index.ts",
    "sanitize.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "tsc --noEmit --strict --target ES2022 --module NodeNext --allowImportingTsExtensions --skipLibCheck index.ts sanitize.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typescript": "6.0.2"
  }
}
